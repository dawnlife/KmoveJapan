<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
  <title>치이카와은행 인터넷뱅킹</title>
</head>
<body>
<!-- 상단 얇은 바 (기업뱅킹/카드/은행소개 등) -->
<div class="topbar">
  <div class="container d-flex justify-content-between">
    <div>
      <a href="#" class="topbar-link">기업뱅킹</a>
      <a href="#" class="topbar-link">치이카와카드</a>
      <a href="#" class="topbar-link">은행소개</a>
      <a href="#" class="topbar-link">채용안내</a>
    </div>
    <div>
      {{#loggedIn}}
      <span class="topbar-link">{{customerName}} 님</span>
      <a href="/logout" class="topbar-link">로그아웃</a>
      {{/loggedIn}}
      <a href="#" class="topbar-link">인증센터</a>
      <a href="#" class="topbar-link">Language ⌄</a>
