  </div>
</div>

<!-- 메인 네비게이션 -->
<nav class="app-navbar">
  <div class="container d-flex justify-content-between align-items-center">
    <a class="brand" href="/main"><img src="/images/logo.png" alt="치이카와은행" class="brand-logo" style="height:57px;width:auto;display:block;"></a>
    <div class="d-none d-md-flex">
      <a href="/main" class="nav-link-custom">조회</a>
      <a href="/transfer" class="nav-link-custom">송금</a>
      <a href="#" class="nav-link-custom">공과금</a>
      <a href="#" class="nav-link-custom">외환</a>
      <a href="#" class="nav-link-custom">금융상품</a>
    </div>
    <div class="d-flex align-items-center gap-3 fs-5">
      <span>💬</span><span>🔍</span><span>☰</span>
    </div>
  </div>
</nav>

<div class="container py-4" style="max-width: 720px;">
