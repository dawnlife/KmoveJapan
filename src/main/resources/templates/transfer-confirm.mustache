{{>header}}
<h4 class="fw-bold mb-3" style="color:#1F3864;">&lt;SCR005&gt; 이체 비밀번호 확인</h4>

<div class="card mb-3">
  <div class="card-body">
    <div class="small text-muted">출금계좌 → 입금계좌</div>
    <div class="mb-2">{{fromAccountNumber}} → {{toAccountNumber}}</div>
    <div class="small text-muted">이체금액</div>
    <div class="fs-4 fw-bold" style="color:#1F3864;">{{amount}} 원</div>
  </div>
</div>

{{#error}}
<div class="alert alert-danger py-2">{{error}}</div>
{{/error}}

<form method="post" action="/transfer/confirm">
  <div class="mb-3">
    <label class="form-label">이체 비밀번호 (4자리)</label>
    <input type="password" class="form-control" name="transferPassword" maxlength="4" required autofocus>
  </div>
  <button type="submit" class="btn" style="background-color:#1F3864;color:white;">確認 (확인)</button>
</form>
{{>footer}}
