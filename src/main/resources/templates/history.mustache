{{>header}}
</div><!-- header의 narrow container를 닫고 아래는 wide 레이아웃 -->

<div class="container py-4" style="max-width: 1100px;">

  <!-- 브레드크럼 -->
  <div class="text-end small text-muted mb-3">
    <a href="/main" class="text-muted text-decoration-none">홈</a>
    <span class="mx-1">></span>
    <span>조회</span>
    <span class="mx-1">></span>
    <span class="fw-bold" style="color:var(--brand-navy);">이체내역조회</span>
  </div>

  <div class="d-flex align-items-end mb-3">
    <h3 class="fw-bold mb-0 me-4">이체내역조회</h3>
    <ul class="nav history-subtabs">
      <li class="nav-item"><a class="nav-link active" href="#">최근(최대 2년)</a></li>
      <li class="nav-item"><a class="nav-link" href="#">과거</a></li>
      <li class="nav-item"><a class="nav-link" href="#">통장미정리내역</a></li>
    </ul>
  </div>

  <form method="get" action="/history">

    <!-- 계좌 선택 박스 -->
    <div class="account-select-box mb-4">
      <select name="accountNumber" class="account-select-input">
        {{#accountOptions}}
        <option value="{{accountNumber}}" {{#selected}}selected{{/selected}}>{{accountNumber}}</option>
        {{/accountOptions}}
      </select>
      <img src="/images/history.png" alt="" class="account-select-mascot" style="width:56px;height:56px;object-fit:contain;">
    </div>

    <!-- 조회기간 -->
    <div class="row align-items-center mb-3">
      <div class="col-md-2 fw-bold">조회기간</div>
      <div class="col-md-6 d-flex align-items-center gap-2">
        <input type="date" class="form-control" name="dateFrom" value="{{dateFrom}}">
        <span>-</span>
        <input type="date" class="form-control" name="dateTo" value="{{dateTo}}">
      </div>
      <div class="col-md-4 d-flex flex-wrap gap-1 mt-2 mt-md-0" id="periodPresets">
        <button type="button" class="btn btn-sm period-btn {{#preset0}}active{{/preset0}}" data-days="0">당일</button>
        <button type="button" class="btn btn-sm period-btn {{#preset3}}active{{/preset3}}" data-days="3">3일</button>
        <button type="button" class="btn btn-sm period-btn {{#preset7}}active{{/preset7}}" data-days="7">1주</button>
        <button type="button" class="btn btn-sm period-btn {{#preset14}}active{{/preset14}}" data-days="14">2주</button>
        <button type="button" class="btn btn-sm period-btn {{#preset30}}active{{/preset30}}" data-days="30">1개월</button>
        <button type="button" class="btn btn-sm period-btn {{#preset90}}active{{/preset90}}" data-days="90">3개월</button>
        <button type="button" class="btn btn-sm period-btn {{#preset180}}active{{/preset180}}" data-days="180">6개월</button>
        <button type="button" class="btn btn-sm period-btn {{#preset365}}active{{/preset365}}" data-days="365">1년</button>
      </div>
    </div>

    <!-- 조회내용 -->
    <div class="row align-items-center mb-3">
      <div class="col-md-2 fw-bold">조회내용</div>
      <div class="col-md-10">
        <div class="btn-group tx-filter-group" role="group">
          <input type="radio" class="btn-check" name="txFilter" id="txAll" value="ALL" {{#txFilterAll}}checked{{/txFilterAll}}>
          <label class="btn btn-outline-secondary" for="txAll">전체(입금+출금)</label>

          <input type="radio" class="btn-check" name="txFilter" id="txWithdraw" value="WITHDRAW" {{#txFilterWithdraw}}checked{{/txFilterWithdraw}}>
          <label class="btn btn-outline-secondary" for="txWithdraw">출금내역</label>

          <input type="radio" class="btn-check" name="txFilter" id="txDeposit" value="DEPOSIT" {{#txFilterDeposit}}checked{{/txFilterDeposit}}>
          <label class="btn btn-outline-secondary" for="txDeposit">입금내역</label>

          <input type="radio" class="btn-check" name="txFilter" id="txInterest" value="INTEREST" {{#txFilterInterest}}checked{{/txFilterInterest}}>
          <label class="btn btn-outline-secondary" for="txInterest">이자지급내역</label>
        </div>
      </div>
    </div>

    <!-- 정렬방식 -->
    <div class="row align-items-center mb-4">
      <div class="col-md-2 fw-bold">정렬방식</div>
      <div class="col-md-10 d-flex flex-wrap align-items-center gap-4">
        <div class="d-flex align-items-center gap-3">
          <span class="text-muted small">건수</span>
          {{#counts}}
          <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="count" id="cnt{{value}}" value="{{value}}" {{#selected}}checked{{/selected}}>
            <label class="form-check-label" for="cnt{{value}}">{{value}}건</label>
          </div>
          {{/counts}}
        </div>
        <div class="d-flex align-items-center gap-3">
          <span class="fw-bold">정렬순서</span>
          <div class="btn-group tx-filter-group" role="group">
            <input type="radio" class="btn-check" name="sortOrder" id="sortRecent" value="recent" {{#sortRecent}}checked{{/sortRecent}}>
            <label class="btn btn-outline-secondary" for="sortRecent">최신순</label>

            <input type="radio" class="btn-check" name="sortOrder" id="sortPast" value="past" {{#sortPast}}checked{{/sortPast}}>
            <label class="btn btn-outline-secondary" for="sortPast">과거순</label>
          </div>
        </div>
      </div>
    </div>

    <!-- 안내문 + 조회버튼 -->
    <div class="row align-items-center mb-4">
      <div class="col-md-8">
        <div class="history-note-box">
          <div class="fw-bold mb-1">총 1개 계좌의 거래내역 확인 가능</div>
          <div>- 최근 2년간의 거래내역조회가 가능합니다.</div>
          <div>- 추가 거래내역은 과거거래내역 조회를 이용하시기 바랍니다.</div>
          <div>- 조회결과는 최대 100건까지 표시됩니다.</div>
        </div>
      </div>
      <div class="col-md-4 text-end" style="padding-right:48px;">
        <div class="login-btn-wrap d-inline-block" style="position:relative;">
          <button type="submit" class="btn btn-brand-yellow btn-lg px-5">조회</button>
          <img src="/images/history_button.png" alt="" class="login-btn-mascot"
               style="position:absolute;left:-40px;top:50%;transform:translateY(-70%);width:80px;height:80px;object-fit:contain;pointer-events:none;">
        </div>
      </div>
    </div>
  </form>

  <!-- 조회 결과 -->
  <div class="card shadow-sm">
    <div class="card-header bg-white fw-bold">
      조회결과 <span class="text-muted small">({{resultCount}}건)</span>
    </div>
    <table class="table table-sm mb-0">
      <thead>
        <tr><th>거래일시</th><th>구분</th><th>출금처</th><th>출금액</th><th>입금액</th><th>잔액</th></tr>
      </thead>
      <tbody>
        {{#history}}
        <tr>
          <td>{{txDatetime}}</td>
          <td>{{txTypeLabel}}</td>
          <td>{{counterpartAccount}}</td>
          <td class="text-danger">{{#isOutgoing}}{{amountFormatted}}{{/isOutgoing}}</td>
          <td class="text-primary">{{^isOutgoing}}{{amountFormatted}}{{/isOutgoing}}</td>
          <td>{{balanceAfterFormatted}}</td>
        </tr>
        {{/history}}
        {{^hasHistory}}
        <tr><td colspan="6" class="text-muted text-center py-4">해당하는 거래 내역이 없습니다.</td></tr>
        {{/hasHistory}}
      </tbody>
    </table>
  </div>

<script>
document.querySelectorAll('.period-btn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    document.querySelectorAll('.period-btn').forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');
    var days = parseInt(btn.dataset.days, 10);
    var to = new Date();
    var from = new Date();
    from.setDate(to.getDate() - days);
    function fmt(d) { return d.toISOString().slice(0, 10); }
    document.querySelector('input[name="dateFrom"]').value = fmt(from);
    document.querySelector('input[name="dateTo"]').value = fmt(to);
  });
});
</script>

{{>footer}}
