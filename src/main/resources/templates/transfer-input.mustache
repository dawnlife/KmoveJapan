{{>header}}
<h4 class="screen-title mb-3">&lt;SCR004&gt; 계좌이체 입력</h4>

{{#error}}
<div class="alert alert-danger py-2">{{error}}</div>
{{/error}}

<form method="post" action="/transfer">
  <div class="mb-3">
    <label class="form-label">출금계좌</label>
    <select class="form-select" name="fromAccountNumber" required>
      <option value="">계좌를 선택하세요</option>
      {{#accounts}}
      <option value="{{accountNumber}}">{{accountNumber}} ({{balanceFormatted}}원)</option>
      {{/accounts}}
    </select>
  </div>
  <div class="mb-3">
    <label class="form-label">입금계좌번호</label>
    <input type="text" class="form-control" name="toAccountNumber" required>
  </div>
  <div class="mb-3">
    <label class="form-label">이체금액</label>
    <input type="number" class="form-control" name="amount" min="1" required>
  </div>
  <div class="mb-3">
    <label class="form-label d-block">이체구분</label>
    <div class="form-check form-check-inline">
      <input class="form-check-input" type="radio" name="transferType" value="IMMEDIATE" checked>
      <label class="form-check-label">즉시이체</label>
    </div>
    <div class="form-check form-check-inline">
      <input class="form-check-input" type="radio" name="transferType" value="RESERVED">
      <label class="form-check-label">예약이체</label>
    </div>
  </div>
  <button type="submit" class="btn btn-brand">振込実行 (이체실행)</button>
</form>
{{>footer}}
